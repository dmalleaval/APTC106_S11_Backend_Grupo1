# Cadena de conexión de MongoDB Atlas (ver guía de despliegue, paso 1)
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/foodplease?retryWrites=true&w=majority

# Cualquier string largo y aleatorio. Para generar uno:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Orígenes permitidos para CORS, separados por coma. Incluir la URL del
# build web (GitHub Pages / Azure Static Web Apps) y localhost para dev.
CORS_ORIGIN=http://localhost:19006,http://localhost:8081,https://dmalleaval.github.io

PORT=4000
